            print("Tie")
            print(rock)
        elif computer_coice == paper:
            print("You lost")
            print(paper)
        else:
            print("You win")
            print(scissors)
    elif user_value == 2:
        print(paper)
        if computer_coice == rock:
            print("You win")
            print(rock)
        elif computer_coice == paper:
            print("Tie")
            print(paper)
        else:
            print("You lost")
            print(scissors)
    elif user_value == 3:
        print(scissors)
        if computer_coice == rock:
            print("You lost")
            print(rock)
        elif computer_coice == paper:
            print("You win")
            print(paper)
        else:
            print("You win")
            print(scissors)
    game()
